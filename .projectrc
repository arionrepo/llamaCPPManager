# LlamaCPP Manager Project Directory Configuration

# Project Root
PROJECT_ROOT="/Users/liborballaty/LocalProjects/GitHubProjectsDocuments/llamaCPPManager"

# Subdirectories
GUI_DIR="${PROJECT_ROOT}/gui-macos"
CLI_DIR="${PROJECT_ROOT}/src"
TESTS_DIR="${PROJECT_ROOT}/tests"
BUILD_DIR="${GUI_DIR}/build"
APP_PATH="${BUILD_DIR}/llamaCPP Manager.app"
DMG_PATH="${BUILD_DIR}/llamaCPP-Manager-*.dmg"

# Application Bundle
APP_BUNDLE_ID="com.llamacpp.manager"
APPLICATION_PATH="/Applications/Llama CPP Manager.app"

# CLI Executable
CLI_EXECUTABLE="${PROJECT_ROOT}/.venv/bin/llamacpp-manager"

# Logging (matches utils.logs_dir(): ~/Library/Logs/llamaCPPManager)
LOG_DIR="${HOME}/Library/Logs/llamaCPPManager"

# Configuration (matches utils.config_path(): ~/Library/Application Support/llamaCPPManager)
CONFIG_DIR="${HOME}/Library/Application Support/llamaCPPManager"